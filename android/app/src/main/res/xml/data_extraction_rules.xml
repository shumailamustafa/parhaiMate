<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. See backup_rules.xml for why the "root" domain is used. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/parhaimate.sqlite" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/parhaimate.sqlite" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
